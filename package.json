{
  "name": "maho-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "typecheck": "pnpm -r --parallel run typecheck",
    "build": "pnpm -r run build",
    "clean": "pnpm -r exec rimraf dist .turbo",
    "test": "vitest --config vitest.node.config.ts run",
    "test:watch": "vitest --config vitest.node.config.ts",
    "test:coverage": "vitest --config vitest.node.config.ts run --coverage"
  },
  "engines": {
    "node": ">=18.17"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^29.1.1",
    "pinia": "^2.1.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "vue-tsc": "^2.0.29"
  }
}
