{
  "name": "@maho/vite-plugin",
  "version": "0.0.1",
  "description": "Maho Vite 插件集合：virtual:maho-config、联邦、共享依赖、CSS Modules、全局 Loading、类型注册表。",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --emitDeclarationOnly --outDir dist || echo skip"
  },
  "dependencies": {
    "@maho/boot": "workspace:*",
    "@originjs/vite-plugin-federation": "^1.3.6"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "vite": "^5.4.0"
  },
  "keywords": ["maho", "vite-plugin", "module-federation"],
  "license": "MIT"
}
