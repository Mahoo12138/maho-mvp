{
  "name": "@maho/cli",
  "version": "0.0.1",
  "description": "Maho CLI: dev + build commands for module federation workspaces.",
  "type": "module",
  "bin": {
    "maho": "./bin/maho.mjs"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["maho", "microfrontend", "cli"],
  "license": "MIT",
  "dependencies": {
    "@maho/boot": "workspace:*",
    "@maho/core": "workspace:*",
    "@maho/vite-plugin": "workspace:*",
    "cac": "^6.7.14",
    "jiti": "^2.4.0",
    "picocolors": "^1.1.1",
    "vite": "^5.0.0"
  }
}
