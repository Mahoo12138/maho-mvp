{
  "name": "@maho/devtools",
  "version": "0.0.1",
  "description": "Maho Devtools — Cordis plugin with WebSocket inspector server",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./shared": {
      "types": "./shared/index.ts",
      "import": "./shared/index.ts"
    }
  },
  "files": [
    "src",
    "shared"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["maho", "devtools", "cordis"],
  "license": "MIT",
  "peerDependencies": {
    "@maho/core": "workspace:*",
    "@maho/devtools-client": "workspace:*",
    "@vitejs/plugin-vue": "^5.0.0",
    "cordis": "*",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@maho/core": "workspace:*",
    "@maho/devtools-client": "workspace:*",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "cordis": "^4.0.0-rc.6",
    "vite": "^5.0.0"
  }
}
